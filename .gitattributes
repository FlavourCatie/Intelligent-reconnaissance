# ============================================================================
#  智能无人系统技术 —— 换行符 / 文件类型处理
# ============================================================================
#  组内既有 Windows 也可能有 Mac 成员，统一换行符可以避免"整文件全是红色 diff"。
#  说明：本仓库不使用 Git LFS（体积已通过 .gitignore 控制到 ~1.5 MB）。
#        如果以后要把演示视频放进仓库，再在这里加 LFS 规则（见 README 第 8 节）。
# ============================================================================

# 让 git 自动识别文本文件，并通过仓库内的规范换行符协作
* text=auto

# 明确按 LF 存——Go/Python/前端社区通用做法，Windows 下检出也会自动转回 CRLF
*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.ini   text eol=lf
*.cfg   text eol=lf
*.bat   text eol=crlf
*.ps1   text eol=crlf
*.ipynb text=auto

# 二进制：告诉 git 不要尝试做文本 diff / 换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.tga   binary
*.gif   binary
*.mp4   binary
*.pdf   binary
*.pptx  binary
*.docx  binary
*.xlsx  binary
*.7z    binary
*.zip   binary
*.egg   binary
*.exe   binary
*.dll   binary
*.pyd   binary
*.uasset binary
*.uexp   binary
*.ubulk  binary

# 让 GitHub 语言统计不要把 Jupyter Notebook 当主语言
*.ipynb linguist-documentation
