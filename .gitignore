# ============================================================================
#  智能无人系统技术 —— 仓库忽略规则
# ============================================================================
#  核心原则：仓库里只放"我们自己写的、或我们会改的"东西。
#            课程发的环境/二进制/教程一律不进库。
#
#  为什么这么严格（实测数据）：
#    · 整个项目目录              10,285 MB / 52,097 个文件
#    · environment_forclass      10,021 MB / 50,314 个文件（UE4 打包环境 + SDK）
#    · Materials/simu_driver     124 MB（课程发的飞控驱动，含 cygwin 运行时）
#    · Materials/...Tutorial     55 MB（五讲教程，含 36 MB 的 gif / 10 MB 的 mp4）
#    · 有 5 个单文件超过 100 MB —— 这是 GitHub 的硬上限，
#      一旦被 add 进仓库，push 会被直接拒绝，而且很难从历史里清掉。
#
#  → 只保留 WorkPlace + easy_follow 代码 + 场景 json，仓库约 1.5 MB，克隆几秒。
# ============================================================================


# ---------------------------------------------------------------------------
# 1. 课程提供的仿真环境（10 GB，含 >100MB 单文件）—— 绝对不能进仓库
# ---------------------------------------------------------------------------
/environment_forclass/


# ---------------------------------------------------------------------------
# 2. 课程提供的二进制 / 工具链 / 教程（不进库，由新成员从课程包自行放入）
# ---------------------------------------------------------------------------
/Materials/simu_driver_windows/
/Materials/Autonomous_Vehicle_PnC_Tutorial-master/

# 场景生成器（每个 8.1 MB，只是把 json 渲染成 3D 场景，改了 json 就够）
/Materials/practice/*/subject4.exe
/Materials/practice/*/*.exe

# 根目录的课程文档与快捷方式（.lnk 里存的是本机绝对路径，换机器就失效）
/UE4 仿真环境配置与安装*.pdf
/智能无人系统技术课程设计任务说明*.pptx
/CarlaUE4 - 快捷方式.lnk


# ---------------------------------------------------------------------------
# 3. 运行时生成物（每次跑都会重新生成，进库只会污染 diff）
# ---------------------------------------------------------------------------
# image_process.skeleton_refinement() 每次往"当前目录"写 66 MB 的 tga + 80 KB 的 png
skeletonized_image.tga
skeletonized_image.png

# 驱动/仿真的日志（实测其中一个就有 35.7 MB）
*.log
/Materials/simu_driver_windows/log/

# 训练/规划过程的临时输出
*.tmp
*.temp
temp/
tmp/


# ---------------------------------------------------------------------------
# 4. Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*$py.class
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
.venv/
env/
.pytest_cache/
.ipynb_checkpoints/


# ---------------------------------------------------------------------------
# 5. 编辑器 / 操作系统
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
Thumbs.db
desktop.ini
.DS_Store


# ---------------------------------------------------------------------------
# 6. 明确要保留的（防止被上面的通配符误伤）
# ---------------------------------------------------------------------------
# 场景配置是我们会改的东西，虽然小但很重要，务必留：
#   Materials/practice/practice1_Scene/{vehicles,targets,game,elements,rands}.json
# 路网图是 tools/scene_map.py 的输入，84 KB：
#   Materials/practice/easy_follow/lib/roadnet.png
# WorkPlace 下的一切（代码/文档/工具/成果图）全部保留。

# ---------------------------------------------------------------------------
# 7. 运行时输出（每次跑都会新增，进库只会越来越大）
# ---------------------------------------------------------------------------
/WorkPlace/figs/uav_view/
/WorkPlace/figs/track_log_*.csv
/WorkPlace/figs/live_snapshot_*.png

# ---------------------------------------------------------------------------
# 8. 组员代码 / 运行产物
# ---------------------------------------------------------------------------
# 无人机模块的日志与状态快照（control_uav.py 自动生成）
/codex_outputs/
# 离线自测生成的截图
/WorkPlace/selftest/*.png

# ---------------------------------------------------------------------------
# 9. 课程讲义 / 大体积素材（不属于代码，可由课程包再次获得）
# ---------------------------------------------------------------------------
/Materials/*.pptx
/Materials/*.pdf
/Materials/practice/easy_follow/map.jpg

# PowerShell 误重定向产物
/$null

